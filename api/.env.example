# ============================================================================
#  EBO SE 2 stack — copy to `.env` and fill in. Never commit your real .env.
# ============================================================================

# --- Enabot account (the same login you use in the EBO HOME app) ---
EBO_EMAIL=you@example.com
EBO_PASSWORD=your-password

# --- App crypto keys: constants from the EBO HOME app, NOT shipped.
#     Extract them once from your own APK — see ebo/docs/GET-APP-KEYS.md.
EBO_PAYLOAD_KEY=
EBO_SIGN_KEY=

# --- Account server + region. EU is the default; use ebox-us.enabotserverintl.com for US accounts.
EBO_HOST=ebox-eu.enabotserverintl.com
EBO_REGION=GB

# --- Shared engine token: the internal data-API token. The API uses it to reach the engine.
#     Pick a long random string.
EBO_API_TOKEN=change-me-to-a-long-random-string

# --- Engine video / TTS tuning (optional; good defaults) ---
EBO_VIDEO=true
EBO_AUDIO=true
EBO_VIDEO_MAX_HEIGHT=720
EBO_TTS_TIMBRE=en-US-AvaMultilingualNeural
EBO_TTS_LANGUAGE=en-US

# --- The public API (what your app talks to) ---
# Client keys your consumers must send as:  Authorization: Bearer <key>
# Comma-separated to issue several. Leave empty + ALLOW_NO_AUTH=true only for local dev.
API_KEYS=change-me-client-key
ALLOW_NO_AUTH=false
CORS_ORIGINS=*
API_PORT=8080

# Host your clients use to reach RTSP directly (the machine running this stack).
RTSP_PUBLIC_HOST=localhost
RTSP_PORT=8554

# --- WebRTC (low-latency browser video) ---
WEBRTC_PORT=8189
# ICE host(s) the browser can reach (comma-separated). Required through Docker:
#   127.0.0.1  → a browser on this same machine
#   <LAN IP>   → other devices on your network
# Note: WebRTC media is UDP; on WSL2 UDP port-forwarding to a Windows browser is unreliable — the
# cockpit falls back to MJPEG automatically if WebRTC can't connect.
EBO_HOST_IPS=127.0.0.1

# Realtime: how often the WebSocket pushes state (seconds)
EVENTS_POLL_SECONDS=2.0

# Keep the control session alive (0 = never sleep; interactive default). Minutes >0 lets the
# robot doze after idle to save battery/privacy.
EBO_STANDBY_MINUTES=0
